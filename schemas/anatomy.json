{
  "$defs": {
    "AnatomyClass": {
      "enum": [
        "human",
        "stylized_humanoid",
        "nonhuman",
        "unknown"
      ],
      "type": "string"
    },
    "AnatomyKind": {
      "enum": [
        "head",
        "body",
        "hand",
        "foot",
        "chain",
        "appendage"
      ],
      "type": "string"
    },
    "AnatomyPart": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AnatomyKind"
        },
        "preserved_part_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prior_form": {
          "type": "string"
        },
        "source_form": {
          "description": "Reviewed structural identity, e.g. human, cloven_hoof, six_limb_chain.",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/AnatomyStrategy"
        }
      },
      "required": [
        "id",
        "kind",
        "source_form",
        "prior_form",
        "strategy",
        "evidence",
        "confirmed"
      ],
      "type": "object"
    },
    "AnatomyReview": {
      "additionalProperties": false,
      "properties": {
        "anatomy_class": {
          "$ref": "#/$defs/AnatomyClass"
        },
        "author": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/AnatomyPart"
          },
          "type": "array"
        },
        "prior_hash": {
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "anatomy_class",
        "source_hash",
        "prior_hash",
        "author",
        "evidence",
        "parts"
      ],
      "type": "object"
    },
    "AnatomyStrategy": {
      "enum": [
        "fit_prior",
        "preserve_source",
        "unresolved"
      ],
      "type": "string"
    },
    "AnatomyUse": {
      "enum": [
        "fit_body",
        "reconstruct_body",
        "complete_body",
        "fit_face",
        "mpfb_batch"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "preserved_part_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "prior_hash": {
      "type": "string"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnatomyReview"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_hash": {
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/AnatomyUse"
    }
  },
  "required": [
    "source_hash",
    "prior_hash",
    "usage"
  ],
  "title": "AnatomyRequest",
  "type": "object"
}
